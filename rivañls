-- Teleport soporta placeId (Firebase) o game.PlaceId
local function teleport(jobId, placeId)
	if not jobId or jobId == "" or jobId == "0" then return end
	if not canJoin() then return end
	local pid = tonumber(placeId) or game.PlaceId
	pcall(function()
		TeleportService:TeleportToPlaceInstance(pid, tostring(jobId), localPlayer)
	end)
end

local function forceTeleport(jobId, duration, placeId)
	if not jobId or jobId == "" or jobId == "0" then return end
	if not canJoin() then return end
	local pid = tonumber(placeId) or game.PlaceId
	local untilTime = os.clock() + (duration or config.forceTime or 10)
	task.spawn(function()
		while os.clock() < untilTime do
			if not hasPerm("autojoin") then break end
			pcall(function()
				TeleportService:TeleportToPlaceInstance(pid, tostring(jobId), localPlayer)
			end)
			task.wait(2.5)
		end
	end)
end



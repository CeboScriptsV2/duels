local function applyThresholdFilter()
	local detected = 0
	for _, child in ipairs(feedScroll:GetChildren()) do
		if child.Name == "EntryWrapper" and entryData[child] then
			local vis = meetsThreshold(entryData[child])
			child.Visible = vis
			if vis then detected += 1 end
		end
	end
	state.detected = detected
	detectedLabel.Text = tostring(state.detected) .. " detected"
	updateCanvas(feedScroll, feedLayout)
end


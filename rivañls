local function playTabBar(name)
	local bar = tabBars[name]
	if not bar then return end
	bar.Size = UDim2.new(0, 2, 0, 0)
	bar.BackgroundTransparency = 0
	tween(bar, { Size = UDim2.new(0, 2, 0, 18) }, 0.3, Enum.EasingStyle.Quint)
	task.delay(0.4, function()
		if bar and bar.Parent and state.tab == name then
			tween(bar, { BackgroundTransparency = 0.25 }, 0.35)
		end
	end)
end

local function switchTab(newTab)
	if newTab and newTab == state.tab then
		return
	end
	if newTab then
		state.tab = newTab
	end
	for name, btn in pairs(tabButtons) do
		local active = name == state.tab
		local bar = tabBars[name]
		if active then
			tween(btn, { TextColor3 = WHITE })
			if tabIcons[name] then tween(tabIcons[name], { ImageColor3 = WHITE }) end
			btn.Font = FONT_LABEL
			tween(tabIndicator, {
				Position = UDim2.new(0, 8, 0, 70 + access.tabIndex(name) * 40),
				Size = UDim2.new(1, -16, 0, 36),
			}, 0.35, Enum.EasingStyle.Quint)
			playTabBar(name)
		else
			tween(btn, { TextColor3 = SILVER })
			if tabIcons[name] then tween(tabIcons[name], { ImageColor3 = SILVER }) end
			btn.Font = FONT_VALUE
			if bar then
				tween(bar, { Size = UDim2.new(0, 2, 0, 0), BackgroundTransparency = 1 }, 0.2)
			end
		end
		if tabPages[name] then
			local pg = tabPages[name]
			if active then
				pg.Visible = true
				if pg:IsA("CanvasGroup") then
					pg.GroupTransparency = 1
					tween(pg, { GroupTransparency = 0 }, 0.3)
				end
			else
				pg.Visible = false
			end
		end
	end
end


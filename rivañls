-- Rebuild SOLO cuando se abre History (y está dirty). Nunca en cada log nuevo.
local function refreshHistory()
	if not histDirty and histRowCount > 0 then return end
	for _, c in ipairs(histScroll:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	histRowCount = 0
	local list = state.history
	local n = math.min(#list, HIST_MAX)
	for i = 1, n do
		makeHistoryRow(list[i], i)
	end
	histDirty = false
	updateCanvas(histScroll, histLayout)
end

-- Añade 1 fila arriba sin destruir todo el History (evita lag al aparecer logs)
appendHistoryRow = function(h)
	table.insert(state.history, 1, h)
	while #state.history > HIST_MAX do
		table.remove(state.history)
	end
	-- Si el usuario NO está en History: solo datos, 0 UI
	if state.tab ~= "History" then
		histDirty = true
		return
	end
	-- Está mirando History: insertar 1 fila barata
	histRowCount = 0
	for _, c in ipairs(histScroll:GetChildren()) do
		if c.Name == "HistRow" then
			histRowCount += 1
			c.LayoutOrder = (c.LayoutOrder or 0) + 1
		end
	end
	makeHistoryRow(h, 0)
	-- Cap visual
	if histRowCount > HIST_MAX then
		local rows = {}
		for _, c in ipairs(histScroll:GetChildren()) do
			if c.Name == "HistRow" then rows[#rows + 1] = c end
		end
		table.sort(rows, function(a, b) return (a.LayoutOrder or 0) > (b.LayoutOrder or 0) end)
		for i = HIST_MAX + 1, #rows do
			rows[i]:Destroy()
			histRowCount -= 1
		end
	end
	histDirty = false
	updateCanvas(histScroll, histLayout)
end

refreshHistoryFn = refreshHistory

local oldSwitch = switchTab
switchTab = function(newTab)
	if newTab and newTab == state.tab then
		return
	end
	oldSwitch(newTab)
	if state.tab == "History" then
		refreshHistory()
	end
end




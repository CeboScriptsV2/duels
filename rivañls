	local knob = create("Frame", {
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(0, 3, 0.5, -9),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = switchBg,
	})
	corner(knob, 9)
	local function update()
		local on = config[key]
		tween(switchBg, { BackgroundColor3 = on and BG_CHIP_ON or BG_CHIP_OFF }, 0.25)
		tween(knob, { Position = on and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9) }, 0.28, Enum.EasingStyle.Quint)
		if swGrad then
			swGrad.Color = bands(on and WHITE or SILVER, STEEL)
		end
	end
	toggleRefresh[key] = update
	update()
	switchBg.MouseButton1Click:Connect(function()
		local newVal = not config[key]
		if guard and not guard(newVal) then return end

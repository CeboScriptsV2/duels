-- Sin limite: cada log muestra su pop-up al instante
local activeLogNotifs = 0
local MAX_LOG_NOTIFS = (touchEnabled or viewportSize.X < 900) and 3 or 5
local liveNotifs = {} -- funciones dismiss, la mas vieja primero

-- Notificaciones ya mostradas (se guardan en archivo: al re-ejecutar NO se repiten)
CX.notified = {}
CX.notifiedDirty = false
do
	local NOTIF_FILE = "CeboFinder_Notified.json"
	local nowTs = os.time()
	if readfile and isfile and isfile(NOTIF_FILE) then
		pcall(function()
			local d = HttpService:JSONDecode(readfile(NOTIF_FILE))
			if type(d) == "table" then
				for uid, ts in pairs(d) do
					if type(ts) == "number" and nowTs - ts < 900 then CX.notified[tostring(uid)] = ts end
				end
			end
		end)
	end
	task.spawn(function()
		while ScreenGui and ScreenGui.Parent do
			task.wait(2)
			if CX.notifiedDirty and writefile then
				CX.notifiedDirty = false
				local t = os.time()
				for uid, ts in pairs(CX.notified) do
					if t - ts >= 900 then CX.notified[uid] = nil end
				end
				pcall(function() writefile(NOTIF_FILE, HttpService:JSONEncode(CX.notified)) end)
			end
		end
	end)
end

logNotifFn = function(data)
	local nUid = tostring(data.eggUid or "")
	if nUid ~= "" then
		if CX.notified[nUid] then return end
		CX.notified[nUid] = os.time()
		CX.notifiedDirty = true
	end
	-- Tope: si ya hay el maximo, se elimina la mas vieja (la de abajo) y la nueva entra arriba
	while #liveNotifs >= MAX_LOG_NOTIFS do
		local oldest = table.remove(liveNotifs, 1)
		if oldest then pcall(oldest) end
	end
	activeLogNotifs += 1
	notifCount += 1

-- Texto de mutacion + efecto (ej: "Divine • Rainbow")
CX.mutDisplay = function(data)
	local mut = (data.mutation and data.mutation ~= "" and data.mutation ~= "—") and tostring(data.mutation) or ""
	local eff = data.effect and tostring(data.effect) or ""
	local rar = data.rarityName and tostring(data.rarityName) or ""
	if eff ~= "" then
		if rar == "" or rar == eff then return eff end
		return rar .. " • " .. eff
	end
	return mut
end

-- Filtros de Settings: mutacion + jugadores del servidor
CX.passesFilters = function(entry)
	local fm = config.filterMut
	if fm and next(fm) ~= nil then
		local hay = (tostring(entry.rarityName or "") .. "|" .. tostring(entry.mutation or "")):lower()
		local okm = false
		for key in pairs(fm) do
			if hay:find(key, 1, true) then okm = true break end
		end
		if not okm then return false end
	end
	local fp = config.filterPlayers
	if fp and next(fp) ~= nil then
		local p = tonumber(entry.players)
		if not p or not fp[p] then return false end
	end
	return true
end

local function meetsThreshold(entry)
	if not entry then return false end
	return (tonumber(entry.mps) or 0) >= math.max(parseValue(config.threshold), 250000000) and CX.passesFilters(entry)
end

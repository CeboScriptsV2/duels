-- Edad del pet (0:40): 1 fila por tick. NUNCA actualizar todas a la vez.
----------------------------------------------------------------
task.spawn(function()
	local cursor = 1
	while ScreenGui and ScreenGui.Parent do
		task.wait(1) -- 1 segundo real (timer fluido, sin saltos)
		local list = {}
		for _, ui in pairs(entryUi) do
			if ui and ui.sub and ui.data and ui.wrapper and ui.wrapper.Parent and ui.wrapper.Visible then
				list[#list + 1] = ui
			end
		end
		if #list == 0 then
			cursor = 1
		else
			-- Repartir: actualizar HASTA 3 filas por segundo (fluido, coste mínimo)
			local n = math.min(3, #list)
			for _ = 1, n do
				if cursor > #list then cursor = 1 end
				paintAgeOnly(list[cursor])
				cursor += 1
			end
		end
	end
end)


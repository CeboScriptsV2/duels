local function addEntry(data)
	if type(data) ~= "table" then return end
	if tonumber(data.placeId) ~= access.PLACE_ID then return end -- otro juego: no se muestra
	-- Anti-duplicado: no crear otra fila si este eggUid ya está en el feed
	local euid = data.eggUid and tostring(data.eggUid) or nil
	if euid and entryUi[euid] and entryUi[euid].wrapper and entryUi[euid].wrapper.Parent then
		return
	end
	local col = valueColor(data.mps, data.og)
	local show = meetsThreshold(data)

	-- History SIEMPRE (datos) si >= 10M, aunque no se pinte en Logs por threshold
	if (tonumber(data.mps) or 0) >= 10000000 and not data.requeued then
		local h = {
			name = data.name,
			mps = data.mps,
			time = now(),
			mutation = CX.mutDisplay(data),
			jobId = data.jobId,
			placeId = data.placeId,
		}
		if appendHistoryRow then
			pcall(appendHistoryRow, h)
		else
			table.insert(state.history, 1, h)
			if #state.history > 50 then table.remove(state.history) end
		end
	end

	-- Si no pasa threshold: no crear card de feed (antes creaba filas invisibles = lag)
	if not show then
		return
	end
	if not data.silent and config.logSoundEnabled then
		playSound(config.logSoundId or "125621644257669", 0.3, 1)
	end
	local isLow = not data.og and (tonumber(data.mps) or 0) < 10000000

	local wrapper = create("Frame", {
		Name = "EntryWrapper",

local function parseValue(str)
	if not str then return 0 end
	local s = tostring(str):gsub("%s+", ""):lower()
	local n = tonumber(s:match("[%d%.]+")) or 0
	if s:find("q") then return n * 1e15 end
	if s:find("t") then return n * 1e12 end
	if s:find("b") then return n * 1e9 end
	if s:find("m") then return n * 1e6 end
	if s:find("k") then return n * 1e3 end
	return n
end

local function formatValue(n)
	n = tonumber(n) or 0
	local function fmt(v, s) return string.format("$%.1f%s/s", v, s):gsub("%.0", "") end
	if n >= 1e15 then return fmt(n / 1e15, "Q") end
	if n >= 1e12 then return fmt(n / 1e12, "T") end
	if n >= 1e9 then return fmt(n / 1e9, "B") end
	if n >= 1e6 then return fmt(n / 1e6, "M") end
	if n >= 1e3 then return fmt(n / 1e3, "K") end
	return "$" .. tostring(math.floor(n)) .. "/s"
end


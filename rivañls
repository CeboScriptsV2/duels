local function loadConfig()
	if not readfile or not isfile then return end
	if not isfile("CeboFinder_Config.json") then return end
	pcall(function()
		local data = HttpService:JSONDecode(readfile("CeboFinder_Config.json"))
		if type(data.forceTime) == "number" then config.forceTime = data.forceTime end
		if type(data.threshold) == "string" then config.threshold = data.threshold end
		if type(data.logSoundId) == "string" and data.logSoundId ~= "" then config.logSoundId = data.logSoundId end
		if type(data.logSoundEnabled) == "boolean" then config.logSoundEnabled = data.logSoundEnabled end
		if type(data.cleanTimes) == "number" then config.cleanTimes = math.clamp(math.floor(data.cleanTimes), 0, 10) end
		if type(data.adminRejoin) == "boolean" then config.adminRejoin = data.adminRejoin end
		if type(data.adminKick) == "boolean" then config.adminKick = data.adminKick end
		if type(data.adminHop) == "boolean" then config.adminHop = data.adminHop end
		-- Limite: maximo 1 opcion activa (respawn cuenta como una)
		local n = ((tonumber(config.cleanTimes) or 0) > 0 and 1 or 0)
		for _, k in ipairs({ "adminRejoin", "adminKick", "adminHop" }) do
			if config[k] then
				n += 1
				if n > 1 then config[k] = false end
			end
		end
		if type(data.hopSpam) == "boolean" then config.hopSpam = data.hopSpam end
		if type(data.hopFilterOne) == "boolean" then config.hopFilterOne = data.hopFilterOne end
		if type(data.logNotify) == "boolean" then config.logNotify = data.logNotify end
		if type(data.viewCebo) == "boolean" then config.viewCebo = data.viewCebo end
		if type(data.autoExec) == "boolean" then config.autoExec = data.autoExec end
		if type(data.filterMut) == "table" then
			config.filterMut = {}
			for _, k in ipairs(data.filterMut) do
				if type(k) == "string" and k ~= "" then config.filterMut[k] = true end
			end
		end
		if type(data.filterPlayers) == "table" then
			config.filterPlayers = {}
			for _, n in ipairs(data.filterPlayers) do
				if type(n) == "number" then config.filterPlayers[n] = true end
			end
		end
	end)
end


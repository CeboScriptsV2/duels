-- Contador real de logs visibles (no se acumula: si se van, baja)
local function recountDetected()
	local n = 0
	for _, ui in pairs(entryUi) do
		if ui and ui.wrapper and ui.wrapper.Parent and ui.wrapper.Visible then
			n += 1
		end
	end
	state.detected = n
	if detectedLabel then
		detectedLabel.Text = tostring(n) .. " detected"
	end
	return n
end


-- Ordena el feed: el que más genera ($/s) arriba, el menor abajo
local function resortFeed()
	local list = {}
	for _, child in ipairs(feedScroll:GetChildren()) do
		if child.Name == "EntryWrapper" and entryData[child] then
			list[#list + 1] = child
		end
	end
	table.sort(list, function(a, b)
		local va = tonumber(entryData[a].mps) or 0
		local vb = tonumber(entryData[b].mps) or 0
		if va ~= vb then return va > vb end
		return a.Name < b.Name
	end)
	for i, child in ipairs(list) do
		child.LayoutOrder = i
	end

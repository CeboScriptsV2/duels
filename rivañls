----------------------------------------------------------------
-- Firebase Poll → Logs (nativo)
----------------------------------------------------------------
local seenEggs = {} -- eggUid → lastAdded timestamp
local lastContentSig = "" -- firma de CONTENIDO (ignora lastSeen) → evita lag cada poll
local pendingResort = false

local function mapEggToEntry(egg)
	local mut = tostring(egg.mutation or egg.rarityName or "")
	return {
		name = tostring(egg.eggName or "Unknown"),
		icon = tostring(egg.eggIcon or ""),
		mps = tonumber(egg.value) or 0,
		jobId = tostring(egg.jobId or ""),
		placeId = tonumber(egg.placeId),
		players = tonumber(egg.players),
		maxPlayers = tonumber(egg.maxPlayers),
		spawnedAt = tonumber(egg.spawnedAt),
		mutation = mut,
		rarityName = tostring(egg.rarityName or ""),
		effect = tostring(egg.effect or ""),
		og = false,
		eggUid = tostring(egg.eggUid),
		silent = false,
	}
end

-- Firma de un entry (sin lastSeen / spawnedAge)
-- SIN players: 7/5 cambia todo el rato y NO debe invalidar contentSig (causaba lag)
local function eggSig(entry)
	return tostring(entry.eggUid or "")
		.. "|" .. tostring(math.floor(tonumber(entry.mps) or 0))
		.. "|" .. tostring(entry.mutation or "")
		.. "|" .. tostring(entry.name or "")
		.. "|" .. tostring(entry.effect or "")
end

local function pruneGone(alive)
	local removed = false
	for uid, ui in pairs(entryUi) do
		if not alive[uid] then
			entryUi[uid] = nil
			seenEggs[uid] = nil
			removeEntry(ui.wrapper)
			removed = true
		end
	end
	for uid in pairs(seenEggs) do
		if type(uid) == "string" and not string.find(uid, "^sec:") and not alive[uid] then
			seenEggs[uid] = nil
		end
	end
	return removed
end

local function flushResort()
	if not pendingResort then return end
	pendingResort = false
	resortFeed()
	updateCanvas(feedScroll, feedLayout)
	recountDetected()
end

-- Descarga SOLO los eggs recientes (orderBy lastSeen + endAt secret) = respuesta minuscula.
-- Requiere ".indexOn": ["lastSeen"] en /eggs en las reglas de Firebase.
-- Si no hay indice, cae automaticamente al metodo completo (como antes).
local eggsIndexed = true
local function fetchEggsBody()
	if eggsIndexed then
		local since = os.time() - STALE_SEC - 10
		local b = httpGet("/eggs.json?orderBy=%22lastSeen%22&startAt=" .. tostring(since) .. "&endAt=%22" .. FEED_SECRET .. "%22")
		if b == nil then return nil end
		if not b:find("\"error\"", 1, true) then
			return b
		end
		eggsIndexed = false -- sin indice: usar descarga completa
	end
	return httpGet("/eggs.json")
end

-- Descarga los eggs desde el inicio del ciclo de 5 min (con margen STALE_SEC) para la grafica de Status
access.fetchBackfill = function()
	local cycStart = math.floor(os.time() / 300) * 300
	local b = httpGet("/eggs.json?orderBy=%22lastSeen%22&startAt=" .. tostring(cycStart - STALE_SEC - 10) .. "&endAt=%22" .. FEED_SECRET .. "%22")
	if b == nil or b == "" or b:find("\"error\"", 1, true) then return end
	local data = {}
	if b ~= "null" then
		local ok, dec = pcall(function() return HttpService:JSONDecode(b) end)
		if not ok or type(dec) ~= "table" then return end
		data = dec
	end
	pcall(access.statusBackfill, data)
end

-- Cola: los logs nuevos aparecen UNO POR UNO (rapido) con su animacion.
-- Antes solo se mostraban 8 por poll y el resto se perdia.
local spawnQueue = {}
local aliveNow = {}
local queueRunning = false
local function runQueue()
	if queueRunning then return end
	queueRunning = true
	task.spawn(function()
		while #spawnQueue > 0 and ScreenGui and ScreenGui.Parent do
			local entry = table.remove(spawnQueue, 1)
			if entry and aliveNow[entry.eggUid] then
				pcall(addEntry, entry)
			end
		end
		queueRunning = false
	end)
end

local function fetchEggs()
	if not access.owner and not access.unlocked then return end
	local body = fetchEggsBody()
	if body == nil then
		setStatus(false, "Offline")
		pcall(access.statusFeed, false, 0)
		return
	end
	if body == "null" or body == "" then
		setStatus(true, "Connected")
		pcall(access.statusFeed, true, 0)
		aliveNow = {}
		CX.lastFresh = {}
		CX.lastFbKeys = {}
		if lastContentSig ~= "empty" then
			lastContentSig = "empty"
			if pruneGone({}) then
				pendingResort = true
				flushResort()
			end
		end
		return
	end

	local ok, data = pcall(function()
		return HttpService:JSONDecode(body)
	end)
	if not ok or type(data) ~= "table" then
		setStatus(false, "Error")
		pcall(access.statusFeed, false, 0)
		return
	end

	setStatus(true, "Connected")
	local nowTs = os.time()
	local alive = {}
	local parts = {} -- para firma de contenido (ordenado)

	-- 1) Solo parsear / filtrar stale. NO tocar UI todavía.
	local fresh = {}
	local fbKeys = {}
	for fbKey, egg in pairs(data) do
		if type(egg) == "table" and egg.eggUid and tonumber(egg.placeId) == access.PLACE_ID then
			local uid = tostring(egg.eggUid)
			fbKeys[uid] = fbKey
			local last = tonumber(egg.lastSeen) or 0
			if (nowTs - last) <= STALE_SEC and not CX.isIgnored(uid) then
				alive[uid] = true
				local entry = mapEggToEntry(egg)
				fresh[uid] = entry
				parts[#parts + 1] = eggSig(entry)
			end
		end
	end
	table.sort(parts)
	local contentSig = table.concat(parts, ";")
	CX.lastFresh = fresh
	CX.lastFbKeys = fbKeys
	aliveNow = alive
	do
		local aliveCount = 0
		for _ in pairs(alive) do aliveCount += 1 end
		pcall(access.statusFeed, true, aliveCount)
	end

	-- CLAVE: lastSeen de Firebase cambia cada pocos segundos → el body JSON cambia
	-- siempre. Antes eso forzaba trabajo de UI aunque no hubiera logs nuevos.
	-- Ahora comparamos solo uid|mps|mut|name (players va por ticker).
	if contentSig == lastContentSig then
		-- Solo sincronizar jugadores en memoria. El ticker pinta 7/# + edad 1 fila/vez.
		for uid, entry in pairs(fresh) do
			local ui = entryUi[uid]
			if ui and ui.data then
				local op, omp = ui.data.players, ui.data.maxPlayers
				if op ~= entry.players or omp ~= entry.maxPlayers then
					ui.data.players = entry.players
					ui.data.maxPlayers = entry.maxPlayers
					ui._staticSub = nil -- el próximo paintAgeOnly redibuja 7/# barato
				end
			end
		end
		return
	end
	lastContentSig = contentSig

	local changed = false
	local newBatch = {}

	for uid, entry in pairs(fresh) do
		local ui = entryUi[uid]
		if ui and ui.wrapper and ui.wrapper.Parent then
			local old = ui.data
			local same = old and eggSig(old) == eggSig(entry)
			ui.data = entry
			entryData[ui.wrapper] = entry
			if not same then
				ui._staticSub = subStatic(entry)
				ui.sub.Text = subText(entry)
				ui.name.Text = entry.name .. "  [ " .. formatValue(entry.mps) .. " ]"
				ui.name.TextColor3 = valueColor(entry.mps, entry.og)
				changed = true
			end
		elseif not seenEggs[uid] then
			pcall(access.statusNew, 1)
			pcall(access.countLog, fbKeys[uid])
			seenEggs[uid] = nowTs
			local secKey = tostring(entry.jobId or "") .. "|" .. tostring(entry.name or "") .. "|" .. tostring(math.floor((entry.mps or 0) / 1e5))
			if not seenEggs["sec:" .. secKey] then
				seenEggs["sec:" .. secKey] = nowTs
				newBatch[#newBatch + 1] = entry
				changed = true
			else
				-- ya vimos un egg "igual" (mismo job/name/tier): no spawnear otra fila
				seenEggs[uid] = nowTs
			end
		end
	end

	if #newBatch > 0 then
		table.sort(newBatch, function(x, y)
			return (tonumber(x.mps) or 0) > (tonumber(y.mps) or 0)
		end)
		for _, entry in ipairs(newBatch) do
			spawnQueue[#spawnQueue + 1] = entry
		end
		runQueue()
	end

	local pruned = pruneGone(alive)
	if pruned or changed then
		pendingResort = true
	end
	flushResort()
end

-- Purga cada 5 min (:04:50, :09:50, ... = 10 s ANTES de cada :00 :05 :10):
-- limpia el feed y borra de Firebase lo que haya quedado, para recibir los logs nuevos en limpio.
CX.purge = function()
	if next(entryUi) == nil and next(CX.lastFbKeys) == nil then return end
	local keys = {}
	local ts = os.time()
	for uid, fbKey in pairs(CX.lastFbKeys) do
		CX.ignored[uid] = ts
		keys[#keys + 1] = fbKey
	end
	for uid in pairs(entryUi) do CX.ignored[uid] = ts end
	for k in pairs(seenEggs) do
		if type(k) == "string" and string.find(k, "^sec:") then seenEggs[k] = nil end
	end
	table.clear(spawnQueue)
	CX.lastFresh = {}
	CX.lastFbKeys = {}
	lastContentSig = ""
	CX.clearFeedUi()
	CX.del(keys)
end

task.spawn(function()
	local lastCycle = -1
	while ScreenGui and ScreenGui.Parent do
		task.wait(0.5)
		local t = os.time()
		local cyc = math.floor(t / 300)
		if t % 300 >= 290 and lastCycle ~= cyc then
			lastCycle = cyc
			pcall(CX.purge)
		end
	end
end)

-- Poll de red. Arranca YA (sin esperas) para que "Connected" salga rapido.
task.spawn(function()
	while ScreenGui and ScreenGui.Parent do
		pcall(fetchEggs)
		task.wait(POLL)
	end
end)


	-- Logica de datos
	local function mean(a, i, j)
		local s, c = 0, 0
		for k = math.max(i, 1), j do
			if a[k] then
				s += a[k]
				c += 1
			end
		end
		return c > 0 and s / c or 0
	end

	local function levelOf(v, avg)
		if v <= 0 then return "bad" end
		if avg <= 0 then return "ok" end
		local r = v / avg
		if r >= 0.8 then return "ok" end
		if r >= 0.4 then return "warn" end
		return "bad"
	end

	local function niceMax(v)
		if v <= 5 then return 5 end
		local mag = 10 ^ math.floor(math.log10(v))
		local f = v / mag
		local nf = (f <= 1 and 1) or (f <= 2 and 2) or (f <= 5 and 5) or 10
		return nf * mag
	end

	local function newPerMin()
		local nowc = os.clock()
		local c = 0
		for i = #st.news, 1, -1 do
			if nowc - st.news[i].t <= 60 then
				c += st.news[i].n
			else
				table.remove(st.news, i)
			end
		end
		return c
	end

	local function computeState()
		local n = #st.samples
		if not st.ready then
			return "wait", "CONECTANDO", "Esperando respuesta de Firebase...", GRAY, nil
		end
		if not st.connected then
			return "bad", "SIN CONEXIÓN", "No hay conexión con Firebase. Reintentando...", RED, nil
		end
		if n < 6 then
			return "wait", "CALIBRANDO", "Reuniendo datos de rendimiento (1 min)...", GRAY, nil
		end
		local cur = mean(st.samples, n - 2, n)
		local avg = mean(st.samples, 1, n)
		local ratio = avg > 0 and cur / avg or 1
		local pct = (ratio - 1) * 100
		if cur <= 0 then
			return "bad", "SIN LOGS", "No llegan logs de este juego. Revisa los scanners y Firebase.", RED, pct
		elseif ratio < 0.4 then
			return "bad", "CRÍTICO", "La entrada de logs cayó fuerte. Posible caída de scanners o lag.", RED, pct
		elseif ratio < 0.8 then
			return "warn", "BAJANDO", "Entran menos logs de lo normal. Vigila los scanners.", AMBER, pct
		elseif pct >= 10 then
			return "ok", "EN ALZA", "Los logs están subiendo. Todo funciona muy bien.", GREEN, pct
		end
		return "ok", "ÓPTIMO", "El finder recibe logs con normalidad.", GREEN, pct
	end

	local function redraw()
		if not StatusPage.Visible then return end
		local abs = plot.AbsoluteSize
		if abs.X < 10 or abs.Y < 10 then return end
		local aspect = abs.X / abs.Y
		local n = #st.samples

		for i = 1, N do
			segs[i].Visible = false
		end
		emptyLbl.Visible = n < 2
		ring.Visible = n >= 1
		dot.Visible = n >= 1

		local maxv, sum = 0, 0
		for _, v in ipairs(st.samples) do
			if v > maxv then maxv = v end
			sum += v
		end
		local avg = n > 0 and sum / n or 0
		local top = niceMax(maxv * 1.15)

		local plotH = chartH - (plotTop + plotBottom)
		yLbls[1].Text = tostring(top)
		yLbls[2].Text = tostring(math.floor(top / 2 + 0.5))
		yLbls[3].Text = "0"
		yLbls[1].Position = UDim2.new(0, 6, 0, plotTop)
		yLbls[2].Position = UDim2.new(0, 6, 0, plotTop + plotH / 2)
		yLbls[3].Position = UDim2.new(0, 6, 0, plotTop + plotH)

		local stepX = 1 / (N - 1)
		local prevX, prevY
		local lastX, lastY, lastCol = 1, 1, GREEN
		for k = 1, n do
			local v = st.samples[k]
			local x = (k - 1) * stepX
			local y = 1 - math.clamp(v / top, 0, 1)
			local col = LV[levelOf(v, avg)]

			if prevX then
				local dxH = (x - prevX) * aspect
				local dyH = y - prevY
				local len = math.sqrt(dxH * dxH + dyH * dyH)
				local seg = segs[k]
				seg.Visible = true
				seg.BackgroundColor3 = col
				seg.Position = UDim2.new((x + prevX) / 2, 0, (y + prevY) / 2, 0)
				seg.Size = UDim2.new(len / aspect, 1, 0, 2)
				seg.Rotation = math.deg(math.atan2(dyH, dxH))
			end
			prevX, prevY = x, y
			lastX, lastY, lastCol = x, y, col
		end

		if n >= 1 then
			ring.Position = UDim2.new(lastX, 0, lastY, 0)
			dot.Position = UDim2.new(lastX, 0, lastY, 0)
			ring.BackgroundColor3 = lastCol
			ring.BackgroundTransparency = 0.75
		end

		if n >= 6 then
			avgLine.Visible = true
			avgLine.Position = UDim2.new(0, 0, 1 - math.clamp(avg / top, 0, 1), 0)
		else
			avgLine.Visible = false
		end
	end

	local function fmtTotal(v)
		local t = tostring(math.floor(v))
		t = t:reverse():gsub("(%d%d%d)", "%1."):reverse()
		t = t:gsub("^%.", "")
		return t
	end

	local function updateTotal()
		local b = httpGet("/logtotal.json")
		local v = b and tonumber(b)
		if v then
			st.total = v
			if st.ready and st.connected then
				cNew.Text = fmtTotal(v)
			end
		end
	end

	local function refreshAll()
		local n = #st.samples
		local level, title, desc, col, pct = computeState()

		bTitle.Text = title
		bDesc.Text = desc
		bTitle.TextColor3 = col
		bBar.BackgroundColor3 = col
		liveDot.BackgroundColor3 = col
		if pct then
			bPct.Text = string.format("%+d%%", math.clamp(math.floor(pct + 0.5), -999, 999))
			bPct.TextColor3 = col
		else
			bPct.Text = "--"
			bPct.TextColor3 = GRAY
		end

		local live_ = st.ready and st.connected
		cActive.Text = live_ and tostring(st.latest) or "—"
		cNew.Text = (live_ and st.total) and fmtTotal(st.total) or "—"
		cAvg.Text = n > 0 and tostring(math.floor(mean(st.samples, 1, n) + 0.5)) or "—"

		local trendTxt, trendCol = "—", WHITE
		if live_ and n >= 8 then
			local recent = mean(st.samples, n - 2, n)
			local earlier = mean(st.samples, n - 7, n - 3)
			local r = earlier > 0 and recent / earlier or (recent > 0 and 2 or 1)
			if r >= 1.1 then
				trendTxt, trendCol = "Alcista", GREEN
			elseif r <= 0.9 then
				trendTxt, trendCol = "Bajista", RED
			else
				trendTxt, trendCol = "Estable", WHITE
			end
		end
		cTrend.Text = trendTxt
		cTrend.TextColor3 = trendCol

		local cs = (st.cycle or math.floor(os.time() / CYCLE)) * CYCLE
		xLbls[1].Text = os.date("%H:%M", cs)
		xLbls[2].Text = os.date("%H:%M:%S", cs + CYCLE / 2)
		xLbls[3].Text = os.date("%H:%M", cs + CYCLE)

		task.spawn(updateTotal)
		redraw()
	end

	local function push(v)
		local t = os.time()
		local cyc = math.floor(t / CYCLE)
		if st.cycle ~= cyc then
			st.cycle = cyc
			st.samples = {}
		end
		local slot = math.clamp(math.floor((t - cyc * CYCLE) / SAMPLE) + 1, 1, N)
		while #st.samples < slot - 1 do
			table.insert(st.samples, st.samples[#st.samples] or v)
		end
		st.samples[slot] = v
	end

	access.statusFeed = function(connected, alive)
		st.connected = connected and true or false
		if connected then
			st.latest = tonumber(alive) or 0
			if st.seenOk then st.warm = true end
			st.seenOk = true
			if not st.backfilled and access.fetchBackfill then
				st.backfilled = true
				task.spawn(access.fetchBackfill)
			end
		end
		if not st.ready then
			st.ready = true
			push(st.connected and st.latest or 0)
			if StatusPage.Visible then refreshAll() end
		end
	end

	access.statusNew = function(n)
		n = tonumber(n) or 0
		if st.warm and n > 0 then
			table.insert(st.news, { t = os.clock(), n = n })
			st.totalNew = (st.totalNew or 0) + n
			-- limpiar viejos (> 60s)
			local nowc = os.clock()
			for i = #st.news, 1, -1 do
				if nowc - st.news[i].t > 60 then
					table.remove(st.news, i)
				end
			end
		end
	end

	-- Reconstruye la grafica desde el inicio del ciclo de 5 min con los logs ya guardados en Firebase
	access.statusBackfill = function(data)
		if type(data) ~= "table" then return end
		local t = os.time()
		local cyc = math.floor(t / CYCLE)
		local cycStart = cyc * CYCLE
		local curSlot = math.clamp(math.floor((t - cycStart) / SAMPLE) + 1, 1, N)
		if st.cycle ~= cyc then
			st.cycle = cyc
			st.samples = {}
		end
		local list = {}
		for _, egg in pairs(data) do
			if type(egg) == "table" and egg.eggUid and tonumber(egg.placeId) == access.PLACE_ID then
				local last = tonumber(egg.lastSeen) or 0
				list[#list + 1] = { tonumber(egg.spawnedAt) or last, last }
			end
		end
		for slot = 1, curSlot - 1 do
			local ts = cycStart + (slot - 1) * SAMPLE
			local c = 0
			for _, e in ipairs(list) do
				if e[1] <= ts and e[2] >= ts - STALE_SEC then c += 1 end
			end
			st.samples[slot] = c
		end
		if StatusPage.Visible then pcall(refreshAll) end
	end

	-- Contador historico: +1 por cada log nuevo (una sola vez por log aunque haya varios Finders)
	local countQueue = {}
	local countRunning = false
	access.countLog = function(key)
		if not key or key == "" then return end
		countQueue[#countQueue + 1] = tostring(key)
		if countRunning then return end
		countRunning = true
		task.spawn(function()
			while #countQueue > 0 do
				local k = table.remove(countQueue, 1)
				pcall(httpSend, "PATCH", "/.json", {
					["logcounted/" .. k] = true,
					["logproof"] = FEED_SECRET,
					["logtotal"] = { [".sv"] = { increment = 1 } },
				})
			end
			countRunning = false
		end)
	end

	task.spawn(function()
		while ScreenGui and ScreenGui.Parent do
			task.wait(SAMPLE) -- 2 segundos
			if st.ready then
				push(st.connected and st.latest or 0)
				if StatusPage.Visible and Main.Visible then
					pcall(refreshAll)
				end
			end
		end
	end)

	Main:GetPropertyChangedSignal("Visible"):Connect(function()
		if Main.Visible and StatusPage.Visible then
			task.defer(function() pcall(refreshAll) end)
		end
	end)
	StatusPage:GetPropertyChangedSignal("Visible"):Connect(function()
		if StatusPage.Visible then
			task.defer(function() pcall(refreshAll) end)
		end
	end)
	plot:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if StatusPage.Visible then pcall(redraw) end
	end)

	refreshAll()
end
do
	local okBuild, errBuild = pcall(access.buildStatus)
	if not okBuild then
		warn("[CeboFinder] Error al construir Status:", errBuild)
	end
end



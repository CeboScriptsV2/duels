	wrapper.Size = UDim2.new(1, 0, 0, 0)
	card.Position = UDim2.new(0, 70, 0, 0)
	card.BackgroundTransparency = 0.9
	tween(wrapper, { Size = UDim2.new(1, 0, 0, 58) }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	tween(card, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0.2 }, 0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

	recountDetected()

	-- Cap de filas: evita crecer infinito (y el lag que eso trae)
	local entries = {}
	for _, c in ipairs(feedScroll:GetChildren()) do
		if c.Name == "EntryWrapper" then entries[#entries + 1] = c end
	end
	if #entries > 120 then
		for i = 1, #entries - 120 do
			local w = entries[i]
			entryData[w] = nil
			if w and w.Parent then w:Destroy() end
		end
	end

	-- deferSort=true cuando vienen varios logs en el mismo poll → un solo resort al final
	if not data._deferSort then
		resortFeed()
		updateCanvas(feedScroll, feedLayout)
	end

	if show and not data.silent and config.logNotify and logNotifFn then
		-- Notifs pesadas: max 2 simultáneas vía throttle interno de logNotifFn
		pcall(logNotifFn, data)
	end

	if show and not data.requeued and hasPerm("autojoin") then
		local mpsNow = tonumber(data.mps) or 0
		local doJoin = config.autoJoin and mpsNow >= (tonumber(config.minAutoJoin) or 0)
		local doForce = config.autoForce and mpsNow >= (tonumber(config.minAutoForce) or 0)
		if doJoin or doForce then
			if joinNotifFn then pcall(joinNotifFn, data.name, data.mps) end
		end
		if doJoin then
			teleport(data.jobId, data.placeId)
		end
		if doForce then
			forceTeleport(data.jobId, config.forceTime, data.placeId)
		end
	end
end

-- Quita del panel un log cuyo Pet ya no está disponible
-- Animación ligera: solo el wrapper (no 20+ tweens por fila = lag en prune masivo)
local function removeEntry(wrapper)
	if not wrapper or not wrapper.Parent then return end
	entryData[wrapper] = nil
	-- limpiar entryUi si apunta aquí
	for uid, ui in pairs(entryUi) do
		if ui and ui.wrapper == wrapper then
			entryUi[uid] = nil
			break
		end
	end
	-- Animación de salida (solo wrapper + card, no cada hijo)
	local card = wrapper:FindFirstChildWhichIsA("Frame")
	tween(wrapper, { Size = UDim2.new(1, 0, 0, 0) }, 0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	if card then
		tween(card, { BackgroundTransparency = 1, Position = UDim2.new(0, -20, 0, 0) }, 0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	end
	task.delay(0.24, function()
		if wrapper and wrapper.Parent then wrapper:Destroy() end
		recountDetected()
		updateCanvas(feedScroll, feedLayout)
	end)
end

-- Re-aplica filtros (Settings): oculta/muestra filas y recrea las que estaban filtradas
CX.refilter = function()
	for _, child in ipairs(feedScroll:GetChildren()) do
		if child.Name == "EntryWrapper" and entryData[child] then
			child.Visible = meetsThreshold(entryData[child])
		end
	end
	local list = {}
	for uid, entry in pairs(CX.lastFresh) do
		local ui = entryUi[uid]
		if not (ui and ui.wrapper and ui.wrapper.Parent) and not CX.isIgnored(uid) and meetsThreshold(entry) then
			list[#list + 1] = entry
		end
	end
	table.sort(list, function(a, b) return (tonumber(a.mps) or 0) > (tonumber(b.mps) or 0) end)
	for _, entry in ipairs(list) do
		local e = table.clone(entry)
		e.requeued = true  -- sin sonido / notificacion / auto-join / history
		e.silent = true
		e._deferSort = true
		pcall(addEntry, e)
	end
	resortFeed()
	updateCanvas(feedScroll, feedLayout)
	recountDetected()
end


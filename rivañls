	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = TAG_TEXT
	lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextScaled = true
	lbl.Parent = bg

	local hl = Instance.new("Highlight")
	hl.Name = "CeboScriptsHL"
	hl.FillColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = 0.7
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = char

	scannerTags[plr.UserId] = { gui = gui, hl = hl, char = char }
end

-- Recalcula quién debe tener marca (mismo servidor + scanner activo)
-- Solo el OWNER ejecuta esto
updateTags = function()
	if not access.canCebo() or not config.viewCebo then
		clearAllTags()
		return
	end
	local want = {}
	for _, u in pairs(usersData) do
		local uid = tonumber(u.userId)
		if uid and uid ~= localPlayer.UserId and tostring(u.jobId or "") == tostring(game.JobId) then
			local plr = Players:GetPlayerByUserId(uid)
			if plr then
				want[uid] = true
				pcall(applyTag, plr)
			end
		end
	end
	for uid in pairs(scannerTags) do
		if not want[uid] then removeTag(uid) end
	end
end

-- Solo el owner registra listeners de tags (ahorra trabajo a whitelistados)
if false then
	Players.PlayerRemoving:Connect(function(plr) removeTag(plr.UserId) end)
	local function watchChar(plr)
		plr.CharacterAdded:Connect(function()
			task.wait(0.2)
			if config.viewCebo and usersData[tostring(plr.UserId)] then pcall(updateTags) end
		end)
	end
	for _, plr in ipairs(Players:GetPlayers()) do watchChar(plr) end
	Players.PlayerAdded:Connect(watchChar)
	ScreenGui.Destroying:Connect(clearAllTags)

	-- Loop local rapido (1s): no depende del poll de Firebase
	task.spawn(function()
		while ScreenGui and ScreenGui.Parent do
			if config.viewCebo then
				pcall(updateTags)
			else
				clearAllTags()
			end
			task.wait(1)
		end
	end)
else
	updateTags = function() end -- no-op para no-owner
end
end

----------------------------------------------------------------
-- AUTO EXECUTE FINDER: tras cada teleport vuelve a ejecutar el Finder
-- (misma logica del scanner: guarda el loader en un archivo y lo relanza con queue_on_teleport)
----------------------------------------------------------------
do
	local LOADER_FOLDER = "CeboLibrary"
	local LOADER_FILE = LOADER_FOLDER .. "/CeboFinderLoader.lua"
	local LOADER_URL = "https://api.luarmor.net/files/v4/loaders/3bfa39bce217c43f7be19c701aeb50be.lua"
	local queuedThisRun = false

	local function saveLoader(src)
		if type(src) ~= "string" or #src < 20 or not writefile then return false end
		pcall(function()
			if isfolder and makefolder and not isfolder(LOADER_FOLDER) then makefolder(LOADER_FOLDER) end
		end)
		return pcall(function() writefile(LOADER_FILE, src) end)
	end

	-- 1) script_key de esta ejecucion (lo define el loader de Luarmor) -> se arma el loader completo
	-- 2) si no hay key, se intenta capturar el source propio (como el scanner)
	-- 3) si tampoco, se usa el loader ya guardado antes
	local function captureLoader()
		local key = nil
		pcall(function()
			local env2 = (getgenv and getgenv()) or _G
			key = env2.script_key or _G.script_key
		end)
		if type(key) == "string" and key ~= "" then
			local src = string.format('script_key=%q; loadstring(game:HttpGet(%q))()', key, LOADER_URL)
			if saveLoader(src) then return true end
		end
		local ok, info = pcall(function() return debug.getinfo and debug.getinfo(1, "S") end)
		if ok and type(info) == "table" and type(info.source) == "string" then
			local raw = info.source
			local src = nil
			if raw:sub(1, 1) == "=" then
				src = raw:sub(2)
			elseif raw:sub(1, 1) == "@" and isfile and readfile and isfile(raw:sub(2)) then
				src = readfile(raw:sub(2))
			end
			if type(src) == "string" and #src > 400 and src:find("CeboFinder_UI", 1, true) then
				if saveLoader(src) then return true end
			end
		end
		if isfile and isfile(LOADER_FILE) then return true end
		return false
	end

	CX.queueAutoExec = function()
		local q = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
		if not q then return false end
		if not captureLoader() then return false end
		if queuedThisRun then return true end
		queuedThisRun = true
		local bootstrap = string.format([==[
			repeat task.wait() until game:IsLoaded()
			local HttpService = game:GetService("HttpService")
			local okC, cfg = pcall(function() return HttpService:JSONDecode(readfile("CeboFinder_Config.json")) end)
			if not (okC and type(cfg) == "table" and cfg.autoExec == true) then return end
			local okS, src = pcall(function() return readfile(%q) end)
			if okS and type(src) == "string" and #src > 20 then
				local fn = loadstring(src)
				if fn then pcall(fn) end
			end
		]==], LOADER_FILE)
		local okQ = pcall(q, bootstrap)
		return okQ
	end

	if config.autoExec then pcall(CX.queueAutoExec) end
end

----------------------------------------------------------------
-- IDENTIFICACION: sobre tu cabeza "discord.gg/cebollita".
-- Los demas que tengan el Finder en TU servidor ven tu avatar azul + "CeboFinder"
-- (y tu ves el suyo igual). Presencia en Firebase: /finders
----------------------------------------------------------------
do
	local selfId = localPlayer.UserId
	local FINDER_BLUE = Color3.fromRGB(25, 70, 160)
	local FINDER_BLUE_LIGHT = Color3.fromRGB(70, 130, 220)
	local finderUsers = {} -- userId -> true (mismo servidor, presencia reciente)
	local fTags = {}       -- userId -> { gui, hl, char }

	local function removeFTag(uid)
		local t = fTags[uid]
		if not t then return end
		fTags[uid] = nil
		pcall(function() if t.gui then t.gui:Destroy() end end)
		pcall(function() if t.hl then t.hl:Destroy() end end)
	end

	local function applyFTag(plr, isSelf)
		local char = plr.Character
		if not char then return end
		local head = char:FindFirstChild("Head")
		if not head then return end
		local cur = fTags[plr.UserId]
		if cur and cur.char == char and cur.gui and cur.gui.Parent then return end
		removeFTag(plr.UserId)

		local gui = Instance.new("BillboardGui")
		gui.Name = "CeboFinderTag"
		gui.Adornee = head
		gui.AlwaysOnTop = true
		gui.Size = UDim2.new(0, isSelf and 170 or 110, 0, 24)
		gui.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
		gui.MaxDistance = math.huge
		gui.ResetOnSpawn = false
		gui.Parent = head

		local bg = Instance.new("Frame")
		bg.Size = UDim2.new(1, 0, 1, 0)
		bg.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
		bg.BackgroundTransparency = 0.25
		bg.BorderSizePixel = 0
		bg.Parent = gui
		local bgc = Instance.new("UICorner")
		bgc.CornerRadius = UDim.new(0, 8)
		bgc.Parent = bg
		local st = Instance.new("UIStroke")
		st.Color = isSelf and Color3.fromRGB(255, 255, 255) or FINDER_BLUE_LIGHT
		st.Thickness = 1.5
		st.Parent = bg
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, -8, 1, -4)
		lbl.Position = UDim2.new(0, 4, 0, 2)
		lbl.BackgroundTransparency = 1
		lbl.Text = isSelf and "discord.gg/cebollita" or "CeboFinder"
		lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
		lbl.Font = Enum.Font.GothamBlack
		lbl.TextScaled = true
		lbl.Parent = bg

		local hl = nil
		if not isSelf then
			hl = Instance.new("Highlight")
			hl.Name = "CeboFinderHL"
			hl.FillColor = FINDER_BLUE
			hl.FillTransparency = 0.3
			hl.OutlineColor = FINDER_BLUE_LIGHT
			hl.OutlineTransparency = 0.2
			hl.DepthMode = Enum.HighlightDepthMode.Occluded
			hl.Parent = char
		end
		fTags[plr.UserId] = { gui = gui, hl = hl, char = char }
	end

	local function refreshFTags()
		local want = {}
		want[selfId] = true
		pcall(applyFTag, localPlayer, true)
		for uid in pairs(finderUsers) do
			local plr = Players:GetPlayerByUserId(uid)
			if plr and uid ~= selfId then
				want[uid] = true
				pcall(applyFTag, plr, false)
			end
		end
		for uid in pairs(fTags) do
			if not want[uid] then removeFTag(uid) end
		end
	end

	-- Latido de presencia (cada 10 s)
	task.spawn(function()
		while ScreenGui and ScreenGui.Parent do
			pcall(httpSend, "PUT", "/finders/" .. tostring(selfId) .. ".json", {
				userId = selfId,
				name = tostring(localPlayer.Name or ""),
				jobId = tostring(game.JobId or ""),
				placeId = tonumber(game.PlaceId) or 0,
				lastSeen = os.time(),
			})
			task.wait(10)
		end
	end)

	-- Lectura de otros Finders (cada 4 s)
	task.spawn(function()
		while ScreenGui and ScreenGui.Parent do
			local since = os.time() - 40
			local body = httpGet("/finders.json?orderBy=%22lastSeen%22&startAt=" .. tostring(since) .. "&endAt=%22" .. FEED_SECRET .. "%22")
			if body and body ~= "" and body ~= "null" and not body:find("\"error\"", 1, true) then
				local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
				if ok and type(data) == "table" then
					local nxt = {}
					for _, u in pairs(data) do
						if type(u) == "table" then
							local uid = tonumber(u.userId)
							if uid and uid ~= selfId and tostring(u.jobId or "") == tostring(game.JobId) then
								nxt[uid] = true
							end
						end
					end
					finderUsers = nxt
				end
			elseif body == "null" then
				finderUsers = {}
			end
			pcall(refreshFTags)
			task.wait(4)
		end
	end)

	-- Re-aplica rapido (respawn, personajes nuevos)
	task.spawn(function()
		while ScreenGui and ScreenGui.Parent do
			pcall(refreshFTags)
			task.wait(1)
		end
	end)

	ScreenGui.Destroying:Connect(function()
		for uid in pairs(fTags) do removeFTag(uid) end
		pcall(function()
			if requestFn then
				requestFn({
					Url = silentUrl(FIREBASE .. "/finders/" .. tostring(selfId) .. ".json"),
					Method = "DELETE",
					Headers = { ["Content-Type"] = "application/json" },
				})
			end
		end)
	end)
end


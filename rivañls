-- Tiempo desde el spawn del Pet en formato m:ss
local function spawnAge(ts)
	local d = math.max(0, os.time() - (tonumber(ts) or os.time()))
	return string.format("%d:%02d", math.floor(d / 60), d % 60)
end

-- Parte ESTÁTICA del sub (sin edad): no cambia cada segundo → no reescribir texto en masa
local function subStatic(data)
	local maxP = tonumber(data.maxPlayers)
	local cur = tonumber(data.players)
	local s = (maxP and tostring(maxP) or "?") .. "/" .. (cur and tostring(cur) or "?")
	local md = CX.mutDisplay(data)
	if md ~= "" then
		s = s .. " • " .. md
	end
	if data.og then s = s .. " • OG" end
	return s
end

-- Texto completo (solo al crear / cuando cambia players-mutación)
local function subText(data)
	if data.spawnedAt then
		return subStatic(data) .. " • " .. spawnAge(data.spawnedAt)
	end
	return subStatic(data)
end

-- Pinta sub de 1 fila: jugadores + edad (barato). Nunca en masa.
local function paintAgeOnly(ui)
	if not ui or not ui.sub or not ui.data then return end
	local base = ui._staticSub
	if not base then
		base = subStatic(ui.data)
		ui._staticSub = base
	end
	if ui.data.spawnedAt then
		ui.sub.Text = base .. " • " .. spawnAge(ui.data.spawnedAt)
	else
		ui.sub.Text = base
	end
end

----------------------------------------------------------------
-- HTTP helpers (Firebase)
-- print=silent: Firebase responde 204 vacio (mucho mas rapido) en escrituras
----------------------------------------------------------------
local function silentUrl(url)
	if url:find("print=silent", 1, true) then return url end
	return url .. (url:find("?", 1, true) and "&" or "?") .. "print=silent"
end

local function httpGet(path)
	local url = FIREBASE .. path
	local body
	local ok = pcall(function()
		if requestFn then
			local res = requestFn({
				Url = url,
				Method = "GET",
				Headers = { ["Content-Type"] = "application/json" },
			})
			body = res and res.Body
		else
			body = game:HttpGet(url)
		end
	end)
	if not ok then return nil end
	return body
end

local function httpPut(path, tbl)
	local url = silentUrl(FIREBASE .. path)
	pcall(function()
		if requestFn then
			requestFn({
				Url = url,
				Method = "PUT",
				Headers = { ["Content-Type"] = "application/json" },
				Body = HttpService:JSONEncode(tbl),
			})
		end
	end)
end

-- Envia PUT/PATCH y devuelve (ok, statusCode)
local function httpSend(method, path, tbl)
	if not requestFn then return false, 0 end
	local ok, res = pcall(function()
		return requestFn({
			Url = silentUrl(FIREBASE .. path),
			Method = method,
			Headers = { ["Content-Type"] = "application/json" },
			Body = (HttpService:JSONEncode(tbl):gsub("\"__NULL__\"", "null")),
		})
	end)
	if not ok or not res then return false, 0 end
	local code = tonumber(res.StatusCode or res.Status or res.statusCode or 0) or 0
	return (code == 0 or (code >= 200 and code < 300)), code
end

-- DELETE de claves de /eggs (en paralelo, sin bloquear)
CX.del = function(keys)
	if not requestFn or not keys or #keys == 0 then return end
	task.spawn(function()
		for i, k in ipairs(keys) do
			task.spawn(function()
				pcall(function()
					requestFn({
						Url = silentUrl(FIREBASE .. "/eggs/" .. tostring(k) .. ".json"),
						Method = "DELETE",
						Headers = { ["Content-Type"] = "application/json" },
					})
				end)
			end)
			if i % 8 == 0 then task.wait(0.1) end
		end
	end)
end

